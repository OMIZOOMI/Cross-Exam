{
  "name": "crossexam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @crossexam/web dev",
    "build": "pnpm typecheck && pnpm --filter @crossexam/web build",
    "start": "pnpm --filter @crossexam/web start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:skeptic": "vitest run packages/agents/src/skeptic.test.ts packages/contracts/src/skeptic.test.ts",
    "test:reproducer": "vitest run packages/agents/src/reproducer.test.ts packages/contracts/src/reproducer.test.ts",
    "test:controlled-reproducer": "vitest run packages/controlled-reproducer/src packages/contracts/src/controlled-reproducer.test.ts",
    "test:fixture-preflight": "vitest run packages/controlled-reproducer/src/fixture*.test.ts packages/contracts/src/controlled-fixture-reproducer.test.ts",
    "reproducer:preflight": "tsx scripts/reproducer-preflight.ts",
    "test:linux-preflight": "vitest run packages/controlled-reproducer/src/linux*.test.ts packages/contracts/src/linux-fixture-preflight.test.ts",
    "reproducer:linux-preflight": "tsx scripts/reproducer-linux-preflight.ts",
    "test:tribunal": "vitest run packages/agents/src packages/contracts/src",
    "test:judge": "vitest run packages/agents/src/judge.test.ts packages/contracts/src/judge.test.ts",
    "test:e2e": "playwright test",
    "scanner:smoke": "pnpm --filter @crossexam/scanner smoke",
    "check": "pnpm lint && pnpm test && pnpm build",
    "test:security": "vitest run packages/engine/src/security",
    "test:scanner": "vitest run apps/scanner/src",
    "test:browser-collector": "vitest run apps/browser-worker/src/browser-collector.test.ts && playwright test -c browser-security.config.ts collector.spec.ts",
    "test:browser-security": "vitest run packages/engine/src/browser-egress apps/browser-worker/src && playwright test -c browser-security.config.ts",
    "test:linux-isolation": "test \"$(uname -s)\" = Linux && bash scripts/prepare-linux-isolation.sh && sudo -n \"$(command -v node)\" node_modules/tsx/dist/cli.mjs scripts/linux-isolation-harness.ts",
    "test:performance": "vitest run apps/browser-worker/src/performance.test.ts && playwright test -c browser-security.config.ts performance.spec.ts",
    "test:accessibility": "vitest run apps/browser-worker/src/accessibility.test.ts && playwright test -c browser-security.config.ts accessibility.spec.ts",
    "test:provider": "vitest run packages/provider-openai/src",
    "test:provider-ledger": "vitest run packages/controlled-provider/src",
    "test:provider-operator": "vitest run scripts/provider-acceptance/operator.test.ts",
    "provider:acceptance": "tsx scripts/provider-acceptance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
